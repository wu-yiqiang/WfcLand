<Page
    x:Class="WfcLand.Views.OverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:WfcLand.Views"
    xmlns:localControls="clr-namespace:WfcLand.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="OverView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            ClipToBounds="True"
            CornerRadius="4">
            <Image Source="/Assets/Images/banner.jpg" />
        </Border>
        <ui:ScrollViewerEx
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Disabled"
            IsScrollAnimationEnabled="True"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Control1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <localControls:CardControl
                    Title="串口助手"
                    Margin="0,10,10,0"
                    Description="串口调试工具,用于串口间数据传输的调试"
                    NavigateTag="SerialMonitor" />
                <localControls:CardControl
                    Title="临时剪切"
                    Margin="10,10,0,0"
                    Description="剪切板的临时截切工具，用于临时性的剪切功能"
                    NavigateTag="PasteLists" />
                <localControls:CardControl
                    Title="SSH"
                    Margin="0,10,10,0"
                    Description="这是一个SSH功能介绍,使用该功能用于远程SSH登录"
                    NavigateTag="Ssh" />
                <localControls:CardControl
                    Title="FTP"
                    Margin="10,10,0,0"
                    Description="这是一个FTP功能介绍"
                    NavigateTag="Ftp" />

            </ItemsControl>
        </ui:ScrollViewerEx>

    </Grid>


</Page>
